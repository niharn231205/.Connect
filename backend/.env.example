PORT=3000
JWT_SECRET=replace_with_a_random_secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternate after transient failures. Set to none to disable the alternate attempt.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional override; by default uses backend/.venv/bin/python, then python3.
# PYTHON_BIN=/absolute/path/to/python
